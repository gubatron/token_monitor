// Provider switcher (spec 04 section 3.2): 4 cells per row. Hosted by
// `PanelWindow` in window.slint.
import { TabRowData } from "types.slint";
import { Theme, Typo, Logos } from "../components/kit.slint";

export component ProviderSwitcher inherits Rectangle {
    in property <[TabRowData]> rows;
    callback select(int, int);
    height: rows.length * 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.separator;
    clip: true;
    VerticalLayout {
        for row[ri] in rows: Rectangle {
            height: 28px;
            if row.top-divider: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.separator;
            }
            HorizontalLayout {
                for cell[ci] in row.cells: Rectangle {
                    background: cell.selected ? Theme.primary.with-alpha(0.08) : transparent;
                    if cell.divider: Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.separator;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        padding-left: 4px;
                        padding-right: 4px;
                        if cell.present && cell.logo-key != "": Image {
                            source: Logos.image(cell.logo-key);
                            colorize: cell.selected ? Theme.primary : Theme.secondary;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - 12px) / 2;
                        }
                        Text {
                            text: cell.label;
                            font-family: Typo.family;
                            font-size: 11px;
                            font-weight: cell.selected ? Typo.semibold : Typo.regular;
                            color: cell.selected ? Theme.primary : Theme.secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        enabled: cell.present;
                        clicked => { root.select(ri, ci); }
                    }
                }
            }
        }
    }
}
