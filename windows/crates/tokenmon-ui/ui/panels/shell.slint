// Panel window shell (spec 04 section 3.2): 420 wide, 12 padding, rounded 12,
// 4-per-row provider switcher, then the selected provider's content.
import { TabRowData } from "types.slint";
import { Theme, Typo, Logos } from "../components/kit.slint";

export component ProviderSwitcher inherits Rectangle {
    in property <[TabRowData]> rows;
    callback select(int, int);
    height: rows.length * 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.separator;
    clip: true;
    VerticalLayout {
        for row[ri] in rows: Rectangle {
            height: 28px;
            if row.top-divider: Rectangle {
                y: 0;
                height: 1px;
                background: Theme.separator;
            }
            HorizontalLayout {
                for cell[ci] in row.cells: Rectangle {
                    background: cell.selected ? Theme.primary.with-alpha(0.08) : transparent;
                    if cell.divider: Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.separator;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        padding-left: 4px;
                        padding-right: 4px;
                        if cell.present && cell.logo-key != "": Image {
                            source: Logos.image(cell.logo-key);
                            colorize: cell.selected ? Theme.primary : Theme.secondary;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - 12px) / 2;
                        }
                        Text {
                            text: cell.label;
                            font-family: Typo.family;
                            font-size: 11px;
                            font-weight: cell.selected ? Typo.semibold : Typo.regular;
                            color: cell.selected ? Theme.primary : Theme.secondary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        enabled: cell.present;
                        clicked => { root.select(ri, ci); }
                    }
                }
            }
        }
    }
}

export component PanelShell inherits Window {
    in property <[TabRowData]> shell-tabs;
    callback shell-select-tab(int, int);
    // The Windows panel does not dismiss itself when it loses focus, so it
    // shows a close button (the host sets this; snapshots keep it off).
    in property <bool> shell-closable: false;
    callback shell-close();
    out property <length> shell-content-height: layout.preferred-height;
    // Undecorated: the panel is a popup, not a document window.
    no-frame: true;
    default-font-family: Typo.family;
    icon: @image-url("../assets/logos/tokenmon-app-icon.png");
    width: 420px;
    height: layout.preferred-height;
    background: Theme.window-background;
    layout := VerticalLayout {
        padding: 12px;
        spacing: 0px;
        if root.shell-closable: HorizontalLayout {
            height: 20px;
            alignment: end;
            Rectangle {
                width: 20px;
                height: 20px;
                Text {
                    text: "\u{00D7}";
                    font-family: Typo.family;
                    font-size: 16px;
                    color: Theme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.shell-close(); }
                }
            }
        }
        ProviderSwitcher {
            rows: root.shell-tabs;
            select(r, c) => { root.shell-select-tab(r, c); }
        }
        Rectangle { height: 12px; }
        VerticalLayout {
            spacing: 10px;
            @children
        }
    }
}
