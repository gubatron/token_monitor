// Data structs filled by src/panels/bridge.rs from the plain-Rust view models.
// The .slint panels only lay out these values; every string is decided in Rust.
// The kit structs are re-exported so the bridge builds them from this compile
// unit (generated Slint structs are per compile unit).
import { DayBar } from "../components/kit.slint";
export { DayBar, BarSegment, CategoryItem, MetricItem, LabelValue } from "../components/kit.slint";

export struct TrackData {
    label: string,
    show-label: bool,
    /// 0...100.
    percent: float,
    color: color,
    caption: string,
    caption-warning: bool,
}

export struct ModelRowData {
    name: string,
    cost: string,
    tag: string,
    share: float,
    color: color,
}

export struct ModelsData {
    present: bool,
    title: string,
    collapsible: bool,
    expanded: bool,
    toggle: string,
    rows: [ModelRowData],
}

export struct DailyData {
    present: bool,
    title: string,
    allowance: string,
    range: string,
    has-nav: bool,
    can-next: bool,
    accent: color,
    bars: [DayBar],
    footer: string,
}

export struct FooterData {
    stale-message: string,
    stale-age: string,
    sign-in-again: string,
    error-text: string,
    sign-out-confirm: string,
}

export struct HeaderData {
    /// `ProviderId::logo_asset_key()`.
    logo-key: string,
    title: string,
    meta: string,
    accent: color,
}

export struct HourSegData {
    height: length,
    color: color,
}

export struct HourBarData {
    bar-height: length,
    segments: [HourSegData],
    axis-label: string,
    tooltip: string,
}

export struct LegendData {
    title: string,
    color: color,
}

export struct OverviewCardData {
    logo-key: string,
    title: string,
    meta: string,
    used-text: string,
    percent: float,
    color: color,
    caption: string,
    caption-tertiary: bool,
    sign-in: string,
    has-sign-out: bool,
}

export struct TabData {
    label: string,
    logo-key: string,
    selected: bool,
    present: bool,
    divider: bool,
}

export struct TabRowData {
    top-divider: bool,
    cells: [TabData],
}
