// Panel building blocks composed from the ws-ui-kit components. Every string
// is decided in Rust (src/panels); these only lay out what they are given.
import { Theme, Typo, PanelCard, PanelSectionHeader, DigitText, SlimUsageTrack, MetricStatGrid, ProviderHeaderRow, StaleDataCaption, CollapsibleSectionHeader, DailyBudgetBars } from "../components/kit.slint";
import { TrackData, ModelsData, DailyData, FooterData, HeaderData } from "types.slint";

/// Plain 12pt caption (secondary, or warning orange).
export component Caption inherits Text {
    in property <bool> warning: false;
    font-family: Typo.family;
    font-size: Typo.body-size;
    wrap: word-wrap;
    color: root.warning ? #ff8c00 : Theme.secondary;
}

/// A small bordered action button ("Sign In to Grok…").
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 24px;
    min-width: label.preferred-width + 24px;
    border-radius: 5px;
    background: Theme.control-background;
    border-width: 1px;
    border-color: Theme.separator;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: button;
    accessible-label: root.text;
    label := Text {
        text: root.text;
        font-family: Typo.family;
        font-size: Typo.caption-size;
        color: Theme.primary;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Provider header row (logo, title, meta, settings cog).
export component PanelHeader inherits ProviderHeaderRow {
    in property <HeaderData> data;
    logo-key: root.data.logo-key;
    title: root.data.title;
    trailing: root.data.meta;
}

/// Slim track from view-model data.
export component UsageTrack inherits SlimUsageTrack {
    in property <TrackData> data;
    label: root.data.label;
    shows-label: root.data.show-label;
    percent: root.data.percent;
    fill: root.data.color;
    caption: root.data.caption-warning ? "" : root.data.caption;
}

/// Pool header row plus tracks: "Usage Pool Weekly ........ 36% Used".
export component PoolCard inherits PanelCard {
    in property <string> title;
    in property <string> trailing;
    in property <[TrackData]> tracks;
    HorizontalLayout {
        spacing: 8px;
        PanelSectionHeader { title: root.title; horizontal-stretch: 1; }
        if root.trailing != "": DigitText { text: root.trailing; }
    }
    for t in root.tracks: VerticalLayout {
        spacing: 5px;
        UsageTrack { data: t; }
        if t.caption-warning && t.caption != "": Caption { text: t.caption; warning: true; }
    }
    @children
}

/// Models card: collapsible header, rows with share bars, View all toggle.
export component ModelsCard inherits PanelCard {
    in property <ModelsData> data;
    callback toggle-expanded();
    callback toggle-show-all();
    if root.data.collapsible: CollapsibleSectionHeader {
        title: root.data.title;
        expanded: root.data.expanded;
        height: 16px;
        toggled => { root.toggle-expanded(); }
    }
    if !root.data.collapsible: PanelSectionHeader { title: root.data.title; }
    for row in root.data.rows: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            DigitText { text: row.name; overflow: elide; }
            if row.tag != "": Text {
                text: row.tag;
                font-family: Typo.family;
                font-size: Typo.micro-size;
                color: Theme.secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            DigitText { text: row.cost; }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.usage-remaining-track;
            Rectangle {
                x: 0;
                width: parent.width * row.share;
                border-radius: 3px;
                background: row.color;
            }
        }
    }
    if root.data.toggle != "": Rectangle {
        height: 16px;
        accessible-role: button;
        accessible-label: root.data.toggle;
        Text {
            text: root.data.toggle;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
            horizontal-alignment: left;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-show-all(); }
        }
    }
}

/// Daily budget card with week paging.
export component DailyCard inherits PanelCard {
    in property <DailyData> data;
    callback previous-week();
    callback next-week();
    DailyBudgetBars {
        days: root.data.bars;
        accent: root.data.accent;
        header-percent: root.data.allowance;
        range-label: root.data.range;
        footer: root.data.footer;
        show-navigation: root.data.has-nav;
        can-previous: true;
        can-next: root.data.can-next;
        previous-week => { root.previous-week(); }
        next-week => { root.next-week(); }
    }
}

/// Stale caption, sign-in-again button and the sign-out control.
export component FooterBlock inherits VerticalLayout {
    in property <FooterData> data;
    callback sign-in-again();
    callback sign-out();
    in-out property <bool> confirming: false;
    spacing: 6px;
    if root.data.stale-message != "": StaleDataCaption {
        message: root.data.stale-message;
        detail: root.data.stale-age;
    }
    if root.data.error-text != "": Caption { text: root.data.error-text; }
    if root.data.sign-in-again != "": ActionButton {
        text: root.data.sign-in-again;
        clicked => { root.sign-in-again(); }
    }
    if root.data.sign-out-confirm != "": HorizontalLayout {
        spacing: 8px;
        alignment: end;
        if root.confirming: Text {
            text: root.data.sign-out-confirm;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
            vertical-alignment: center;
        }
        if root.confirming: Rectangle {
            width: 20px;
            height: 20px;
            accessible-role: button;
            accessible-label: "Confirm sign out";
            Text { text: "✓"; color: Theme.destructive; font-size: 12px; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.confirming = false; root.sign-out(); }
            }
        }
        if root.confirming: Rectangle {
            width: 20px;
            height: 20px;
            accessible-role: button;
            accessible-label: "Cancel";
            Text { text: "✕"; color: Theme.secondary; font-size: 12px; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.confirming = false; }
            }
        }
        if !root.confirming: Rectangle {
            width: 20px;
            height: 20px;
            accessible-role: button;
            accessible-label: "Sign out";
            Text { text: "⏏"; color: Theme.tertiary; font-size: 11px; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.confirming = true; }
            }
        }
    }
}

/// Explanatory text with an optional primary button (non-usage states).
export component MessageBlock inherits VerticalLayout {
    in property <string> text;
    in property <string> button;
    callback clicked();
    spacing: 10px;
    if root.text != "": Caption { text: root.text; }
    if root.button != "": ActionButton {
        text: root.button;
        width: 160px;
        clicked => { root.clicked(); }
    }
}
