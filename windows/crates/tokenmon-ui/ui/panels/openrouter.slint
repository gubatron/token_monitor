import { PanelShell } from "shell.slint";
import { PanelHeader, PoolCard, DailyCard, ModelsCard, FooterBlock, MessageBlock, Caption, ActionButton } from "parts.slint";
import { Theme, Typo, PanelCard, PanelSectionHeader, DigitText, MetricStatGrid } from "../components/kit.slint";
import { TrackData, ModelsData, FooterData, HeaderData, TabRowData, MetricItem } from "types.slint";

// OpenRouter panel (spec 03 section 4.6): API key entry instead of a sign-in window.
export component OpenRouterPanel inherits PanelShell {
    in property <[TabRowData]> tabs <=> root.shell-tabs;
    out property <length> content-height: root.shell-content-height;
    callback select-tab(int, int);
    shell-select-tab(r, c) => { root.select-tab(r, c); }
    callback open-settings();
    callback sign-out();
    /// The user typed in the key field (argument: the new draft).
    callback key-edited(string);
    /// The Connect button was pressed (argument: the draft key).
    callback submit-key(string);
    /// The "Replace API Key…" link was pressed.
    callback replace-key();
    callback toggle-show-all-models();
    in property <HeaderData> header;
    in property <bool> has-usage;
    in property <string> message;
    in property <string> budget-title;
    in property <string> used-text;
    in property <[TrackData]> tracks;
    in property <string> no-limit;
    in property <[MetricItem]> stats;
    in property <ModelsData> models;
    in property <bool> has-key-entry;
    in property <string> key-placeholder;
    in property <string> key-button;
    in property <bool> key-button-enabled;
    in property <string> key-error;
    in property <string> replace-link;
    in property <FooterData> footer;
    in-out property <string> key-draft;
    PanelHeader { data: root.header; open-settings => { root.open-settings(); } }
    if !root.has-usage: Caption { text: root.message; }
    if root.has-usage: PoolCard {
        title: root.budget-title;
        trailing: root.used-text;
        tracks: root.tracks;
    }
    if root.has-usage && root.no-limit != "": Caption { text: root.no-limit; }
    if root.has-usage: VerticalLayout {
        spacing: 8px;
        PanelSectionHeader { title: "Stats"; }
        MetricStatGrid { items: root.stats; }
    }
    if root.has-usage && root.models.present: ModelsCard {
        data: root.models;
        toggle-show-all => { root.toggle-show-all-models(); }
    }
    if root.has-key-entry: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 24px;
                horizontal-stretch: 1;
                border-radius: 5px;
                background: Theme.control-background;
                border-width: 1px;
                border-color: Theme.separator;
                if root.key-draft == "": Text {
                    x: 8px;
                    text: root.key-placeholder;
                    font-family: Typo.family;
                    font-size: Typo.body-size;
                    color: Theme.tertiary;
                    vertical-alignment: center;
                }
                input := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    text <=> root.key-draft;
                    font-family: Typo.family;
                    font-size: Typo.body-size;
                    color: Theme.primary;
                    input-type: password;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-label: root.key-placeholder;
                    edited => { root.key-edited(self.text); }
                    accepted => { if root.key-button-enabled { root.submit-key(self.text); } }
                }
            }
            ActionButton {
                width: 72px;
                text: root.key-button;
                enabled: root.key-button-enabled;
                clicked => { root.submit-key(root.key-draft); }
            }
        }
        if root.key-error != "": Text {
            text: root.key-error;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.destructive;
            wrap: word-wrap;
        }
    }
    if root.replace-link != "": Rectangle {
        height: 16px;
        accessible-role: button;
        accessible-label: root.replace-link;
        Text {
            text: root.replace-link;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
            horizontal-alignment: left;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.replace-key(); }
        }
    }
    if root.has-usage: FooterBlock {
        data: root.footer;
        sign-out => { root.sign-out(); }
    }
}
