import { PanelHeader, PoolCard, DailyCard, ModelsCard, FooterBlock, MessageBlock, Caption, ActionButton } from "parts.slint";
import { Theme, Typo, PanelCard, PanelSectionHeader, DigitText, MetricStatGrid } from "../components/kit.slint";
import { TrackData, ModelsData, FooterData, HeaderData, TabRowData, MetricItem } from "types.slint";

/// State and actions of the OpenRouter panel body; the host sets and connects these once.
export global OpenRouterVm {
    callback open-settings();
    callback sign-out();
    /// The user typed in the key field (argument: the new draft).
    callback key-edited(string);
    /// The Connect button was pressed (argument: the draft key).
    callback submit-key(string);
    /// The "Replace API Key…" link was pressed.
    callback replace-key();
    callback toggle-show-all-models();
    in property <HeaderData> header;
    in property <bool> has-usage;
    in property <string> message;
    in property <string> budget-title;
    in property <string> used-text;
    in property <[TrackData]> tracks;
    in property <string> no-limit;
    in property <[MetricItem]> stats;
    in property <ModelsData> models;
    in property <bool> has-key-entry;
    in property <string> key-placeholder;
    in property <string> key-button;
    in property <bool> key-button-enabled;
    in property <string> key-error;
    in property <string> replace-link;
    in property <FooterData> footer;
    in-out property <string> key-draft;
}

// OpenRouter panel (spec 03 section 4.6): API key entry instead of a sign-in window.
export component OpenRouterBody inherits VerticalLayout {
    spacing: 10px;
    PanelHeader { data: OpenRouterVm.header; open-settings => { OpenRouterVm.open-settings(); } }
    if !OpenRouterVm.has-usage: Caption { text: OpenRouterVm.message; }
    if OpenRouterVm.has-usage: PoolCard {
        title: OpenRouterVm.budget-title;
        trailing: OpenRouterVm.used-text;
        tracks: OpenRouterVm.tracks;
    }
    if OpenRouterVm.has-usage && OpenRouterVm.no-limit != "": Caption { text: OpenRouterVm.no-limit; }
    if OpenRouterVm.has-usage: VerticalLayout {
        spacing: 8px;
        PanelSectionHeader { title: "Stats"; }
        MetricStatGrid { items: OpenRouterVm.stats; }
    }
    if OpenRouterVm.has-usage && OpenRouterVm.models.present: ModelsCard {
        data: OpenRouterVm.models;
        toggle-show-all => { OpenRouterVm.toggle-show-all-models(); }
    }
    if OpenRouterVm.has-key-entry: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 24px;
                horizontal-stretch: 1;
                border-radius: 5px;
                background: Theme.control-background;
                border-width: 1px;
                border-color: Theme.separator;
                if OpenRouterVm.key-draft == "": Text {
                    x: 8px;
                    text: OpenRouterVm.key-placeholder;
                    font-family: Typo.family;
                    font-size: Typo.body-size;
                    color: Theme.tertiary;
                    vertical-alignment: center;
                }
                input := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    text <=> OpenRouterVm.key-draft;
                    font-family: Typo.family;
                    font-size: Typo.body-size;
                    color: Theme.primary;
                    input-type: password;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-label: OpenRouterVm.key-placeholder;
                    edited => { OpenRouterVm.key-edited(self.text); }
                    accepted => { if OpenRouterVm.key-button-enabled { OpenRouterVm.submit-key(self.text); } }
                }
            }
            ActionButton {
                width: 72px;
                text: OpenRouterVm.key-button;
                enabled: OpenRouterVm.key-button-enabled;
                clicked => { OpenRouterVm.submit-key(OpenRouterVm.key-draft); }
            }
        }
        if OpenRouterVm.key-error != "": Text {
            text: OpenRouterVm.key-error;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.destructive;
            wrap: word-wrap;
        }
    }
    if OpenRouterVm.replace-link != "": Rectangle {
        height: 16px;
        accessible-role: button;
        accessible-label: OpenRouterVm.replace-link;
        Text {
            text: OpenRouterVm.replace-link;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
            horizontal-alignment: left;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { OpenRouterVm.replace-key(); }
        }
    }
    if OpenRouterVm.has-usage: FooterBlock {
        data: OpenRouterVm.footer;
        sign-out => { OpenRouterVm.sign-out(); }
    }
}
