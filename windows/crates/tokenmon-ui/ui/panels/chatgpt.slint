import { PanelHeader, PoolCard, DailyCard, ModelsCard, FooterBlock, MessageBlock, Caption, ActionButton } from "parts.slint";
import { Theme, Typo, PanelCard, PanelSectionHeader, DigitText, ResetCaption, SegmentedUsageBar, CategoryRow, MetricStatGrid } from "../components/kit.slint";
import { TrackData, ModelsData, DailyData, FooterData, HeaderData, TabRowData, BarSegment, CategoryItem, MetricItem } from "types.slint";

/// State and actions of the ChatGpt panel body; the host sets and connects these once.
export global ChatGptVm {
    callback open-settings();
    callback sign-in();
    callback sign-in-again();
    callback sign-out();
    in property <HeaderData> header;
    in property <bool> has-usage;
    in property <string> message;
    in property <string> button;
    in property <string> pool-title;
    in property <[TrackData]> tracks;
    in property <string> blocked;
    in property <FooterData> footer;
}

// ChatGPT panel (spec 03 section 2.7). No bars, no hover.
export component ChatGptBody inherits VerticalLayout {
    spacing: 10px;
    PanelHeader { data: ChatGptVm.header; open-settings => { ChatGptVm.open-settings(); } }
    if !ChatGptVm.has-usage: MessageBlock {
        text: ChatGptVm.message;
        button: ChatGptVm.button;
        clicked => { ChatGptVm.sign-in(); }
    }
    if ChatGptVm.has-usage: PoolCard { title: ChatGptVm.pool-title; tracks: ChatGptVm.tracks; }
    if ChatGptVm.has-usage && ChatGptVm.blocked != "": Caption { text: ChatGptVm.blocked; warning: true; }
    if ChatGptVm.has-usage: FooterBlock {
        data: ChatGptVm.footer;
        sign-in-again => { ChatGptVm.sign-in-again(); }
        sign-out => { ChatGptVm.sign-out(); }
    }
}
