import { PanelHeader, PoolCard, DailyCard, ModelsCard, FooterBlock, MessageBlock, Caption, ActionButton } from "parts.slint";
import { Theme, Typo, PanelCard, PanelSectionHeader, DigitText, ResetCaption, SegmentedUsageBar, CategoryRow, MetricStatGrid } from "../components/kit.slint";
import { TrackData, ModelsData, DailyData, FooterData, HeaderData, TabRowData, BarSegment, CategoryItem, MetricItem } from "types.slint";

/// State and actions of the Grok panel body; the host sets and connects these once.
export global GrokVm {
    callback open-settings();
    callback sign-in();
    callback sign-in-again();
    callback sign-out();
    in property <HeaderData> header;
    in property <bool> has-usage;
    in property <string> message;
    in property <string> button;
    callback previous-week();
    callback next-week();
    in property <string> pool-title;
    in property <string> pool-used;
    in property <[BarSegment]> segments;
    in property <string> reset-caption;
    in property <bool> has-categories;
    in property <[CategoryItem]> chips;
    in property <string> extra-credits;
    in property <DailyData> daily;
    in property <FooterData> footer;
}

// Grok panel (spec 02 section 1.7).
export component GrokBody inherits VerticalLayout {
    spacing: 10px;
    PanelHeader { data: GrokVm.header; open-settings => { GrokVm.open-settings(); } }
    if !GrokVm.has-usage: MessageBlock {
        text: GrokVm.message;
        button: GrokVm.button;
        clicked => { GrokVm.sign-in(); }
    }
    if GrokVm.has-usage: PanelCard {
        HorizontalLayout {
            spacing: 8px;
            PanelSectionHeader { title: GrokVm.pool-title; horizontal-stretch: 1; }
            DigitText { text: GrokVm.pool-used; }
        }
        SegmentedUsageBar { segments: GrokVm.segments; }
        if GrokVm.reset-caption != "": ResetCaption { text: GrokVm.reset-caption; }
    }
    if GrokVm.has-usage && GrokVm.has-categories: PanelCard {
        PanelSectionHeader { title: "Categories"; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            for chip in GrokVm.chips: CategoryRow {
                name: chip.name;
                percent-text: chip.percent-text;
                dot: chip.color;
            }
        }
    }
    if GrokVm.has-usage && GrokVm.extra-credits != "": PanelCard {
        HorizontalLayout {
            PanelSectionHeader { title: "Extra Credits"; horizontal-stretch: 1; }
            DigitText { text: GrokVm.extra-credits; }
        }
    }
    if GrokVm.has-usage && GrokVm.daily.present: DailyCard {
        data: GrokVm.daily;
        previous-week => { GrokVm.previous-week(); }
        next-week => { GrokVm.next-week(); }
    }
    if GrokVm.has-usage: FooterBlock {
        data: GrokVm.footer;
        sign-in-again => { GrokVm.sign-in-again(); }
        sign-out => { GrokVm.sign-out(); }
    }
}
