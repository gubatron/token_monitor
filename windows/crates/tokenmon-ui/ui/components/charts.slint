// Daily bar charts, week paging and the hover label (spec 04 section 3.4).
import { Theme, Typo, PanelMetrics } from "theme.slint";
import { DayBar, LabelValue, HoverCardData } from "types.slint";
import { PanelSectionHeader, DigitText } from "basics.slint";

/// Pointer-to-chart geometry, mirrored by `tokenmon_ui::kit::hover`
/// (unit tests pin both to the same table).
export global HoverMath {
    /// Column under `x`, or -1 when none (`x` < 0, bad width, past the last column).
    pure public function column-index(x: length, column-width: length, columns: int) -> int {
        if (columns < 1 || column-width <= 0px || x < 0px) {
            -1
        } else if (floor(x / column-width) < columns) {
            floor(x / column-width)
        } else {
            -1
        }
    }

    /// Left edge of the floating label: beside the pointer (left preferred,
    /// right when the left side would leave the container).
    pure public function label-x(pointer-x: length, label-width: length, container-width: length) -> length {
        if (pointer-x - PanelMetrics.hover-gap - label-width >= 0px) {
            pointer-x - PanelMetrics.hover-gap - label-width
        } else if (pointer-x + PanelMetrics.hover-gap + label-width <= container-width) {
            pointer-x + PanelMetrics.hover-gap
        } else {
            max(0px, min(pointer-x - PanelMetrics.hover-gap - label-width, container-width - label-width))
        }
    }

    /// Stands for "no bottom limit" in `label-y`.
    out property <length> no-limit: 100000px;

    /// Top edge of the floating label: centered on the pointer, raised so its
    /// bottom stays above `max-y` (a container near the panel's bottom), then
    /// kept inside the window of height `window-height`.
    pure public function label-y(pointer-y: length, label-height: length, max-y: length, window-height: length) -> length {
        max(0px, min(min(pointer-y - label-height / 2, max-y - label-height), window-height - label-height))
    }
}

/// Left / right chevrons above a daily chart. The left button is enabled by
/// `can-previous`, the right one by `can-next`.
export component WeekChartNavigation inherits HorizontalLayout {
    in property <bool> can-previous: true;
    in property <bool> can-next: false;
    callback previous-week();
    callback next-week();
    spacing: 8px;
    alignment: space-between;
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 5px;
        background: Theme.nav-button-background;
        accessible-role: button;
        accessible-label: "Previous week";
        Image {
            source: @image-url("../assets/icons/chevron-left.svg");
            colorize: Theme.secondary;
            width: 12px;
            height: 12px;
            opacity: root.can-previous ? 1 : 0.35;
        }
        TouchArea {
            enabled: root.can-previous;
            mouse-cursor: root.can-previous ? pointer : default;
            clicked => { root.previous-week(); }
        }
    }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 5px;
        background: Theme.nav-button-background;
        accessible-role: button;
        accessible-label: "Next week";
        Image {
            source: @image-url("../assets/icons/chevron-right.svg");
            colorize: Theme.secondary;
            width: 12px;
            height: 12px;
            opacity: root.can-next ? 1 : 0.35;
        }
        TouchArea {
            enabled: root.can-next;
            mouse-cursor: root.can-next ? pointer : default;
            clicked => { root.next-week(); }
        }
    }
}

component HoverDivider inherits Rectangle {
    height: 1px;
    background: Theme.separator;
    opacity: 0.4;
}

/// Label/value rows in two columns, values right-aligned.
component HoverRows inherits VerticalLayout {
    in property <[LabelValue]> rows;
    in property <bool> elide-labels: false;
    spacing: 1px;
    for row in root.rows: HorizontalLayout {
        spacing: 12px;
        Text {
            text: row.label;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
            horizontal-stretch: 1;
            overflow: root.elide-labels ? TextOverflow.elide : TextOverflow.clip;
        }
        Text {
            text: row.value;
            font-family: Typo.family;
            font-size: Typo.micro-size;
            font-weight: Typo.semibold;
            color: Theme.primary;
            horizontal-alignment: right;
        }
    }
}

/// The floating card of every hover label: title, optional caption, token
/// total with its value, breakdown rows, then a lower block (extra rows,
/// note, verdict). Mirrors Swift's `HoverLabelCard` and its parts.
export component HoverLabelCard inherits Rectangle {
    in property <HoverCardData> card;
    width: content.preferred-width;
    height: content.preferred-height;
    background: Theme.window-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.separator;
    drop-shadow-color: #00000040;
    drop-shadow-blur: 6px;
    drop-shadow-offset-y: 2px;
    content := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;
        Text {
            text: root.card.title;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            font-weight: Typo.semibold;
            color: Theme.primary;
        }
        if root.card.caption != "": Text {
            text: root.card.caption;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
        }
        if root.card.total != "": HoverDivider { }
        if root.card.total != "": HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.card.total;
                font-family: Typo.family;
                font-size: Typo.title-size;
                font-weight: Typo.semibold;
                color: Theme.primary;
            }
            Text {
                text: root.card.unit != "" ? root.card.unit : "tokens";
                font-family: Typo.family;
                font-size: Typo.caption-size;
                color: Theme.secondary;
                vertical-alignment: bottom;
            }
            Rectangle { min-width: root.card.value != "" ? 10px : 0px; horizontal-stretch: 1; }
            Text {
                text: root.card.value;
                font-family: Typo.family;
                font-size: Typo.body-size;
                font-weight: Typo.semibold;
                color: Theme.secondary;
                vertical-alignment: bottom;
            }
        }
        if root.card.total != "": HoverRows { rows: root.card.rows; }
        if root.card.total != "" && (root.card.extra-rows.length > 0 || root.card.note != "" || root.card.verdict != ""): HoverDivider { }
        if root.card.extra-rows.length > 0: HoverRows { rows: root.card.extra-rows; elide-labels: true; }
        if root.card.note != "": Text {
            text: root.card.note;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            color: Theme.secondary;
        }
        if root.card.verdict != "": Text {
            text: root.card.verdict;
            font-family: Typo.family;
            font-size: Typo.caption-size;
            font-weight: Typo.semibold;
            color: Theme.primary;
        }
    }
}

/// The one floating hover label's state. Charts and model rows publish the
/// hovered item here (window coordinates) and `HoverOverlayHost`, a direct
/// child of the window, draws it above every card. A label drawn inside its
/// own card is painted over by the cards after it, which hid the token block
/// of a daily bar hovered above other cards.
export global HoverOverlay {
    in-out property <bool> active;
    in-out property <HoverCardData> card;
    /// Pointer position in window coordinates.
    in-out property <length> pointer-x;
    in-out property <length> pointer-y;
    /// Left edge and width of the hovered container, window coordinates.
    in-out property <length> region-x;
    in-out property <length> region-width;
    /// Window y the label's bottom may not pass (`HoverMath.no-limit` for none).
    in-out property <length> region-bottom;

    /// Publishes (or, with `active` false, hides) the label.
    public function show(active: bool, card: HoverCardData, pointer-x: length, pointer-y: length, region-x: length, region-width: length, region-bottom: length) {
        self.active = active;
        self.card = card;
        self.pointer-x = pointer-x;
        self.pointer-y = pointer-y;
        self.region-x = region-x;
        self.region-width = region-width;
        self.region-bottom = region-bottom;
    }
}

/// Draws the floating hover label. Place it as the last child of the window,
/// sized to fill it, so it paints above everything.
export component HoverOverlayHost inherits Rectangle {
    if HoverOverlay.active && HoverOverlay.card.title != "": HoverLabelCard {
        card: HoverOverlay.card;
        x: HoverOverlay.region-x + HoverMath.label-x(HoverOverlay.pointer-x - HoverOverlay.region-x, self.width, HoverOverlay.region-width);
        y: HoverMath.label-y(HoverOverlay.pointer-y, self.height, HoverOverlay.region-bottom, root.height);
    }
}

/// One day column: 12x68 stem (track + bottom-up fill) over two labels.
component DayColumn inherits VerticalLayout {
    in property <DayBar> day;
    in property <color> accent;
    in property <bool> hovered;
    spacing: 4px;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: PanelMetrics.stem-width;
            height: PanelMetrics.stem-height;
            background: Theme.usage-remaining-track;
            border-radius: PanelMetrics.stem-radius;
            if root.day.show-fill: Rectangle {
                width: parent.width;
                height: min(PanelMetrics.stem-height, max(6px, PanelMetrics.stem-height * root.day.fill-percent / 100));
                y: parent.height - self.height;
                background: root.accent;
                opacity: root.day.prior-window ? 0.45 : 1;
                border-radius: PanelMetrics.stem-radius;
            }
            Rectangle {
                border-radius: PanelMetrics.stem-radius;
                border-width: 1px;
                border-color: root.hovered ? Theme.stem-hover-outline : transparent;
            }
        }
    }
    VerticalLayout {
        height: 32px;
        spacing: 1px;
        alignment: start;
        opacity: root.day.future ? 0.5 : 1;
        Text {
            text: root.day.label-percent;
            font-family: Typo.family;
            font-size: Typo.micro-size;
            font-weight: Typo.semibold;
            color: Theme.primary;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.day.label-weekday;
            font-family: Typo.family;
            font-size: Typo.micro-size;
            font-weight: Typo.semibold;
            color: Theme.secondary;
            horizontal-alignment: center;
        }
    }
}

/// The shared chart body: header, optional paging, bars with hover, footer.
/// `DailyBudgetBars` and `DailyUsageChart` are thin wrappers.
component DailyChartBody inherits VerticalLayout {
    in property <string> title;
    /// "14.3%" next to the title; empty hides it.
    in property <string> header-percent;
    in property <string> range-label;
    in property <[DayBar]> days;
    in property <color> accent;
    in property <string> footer;
    in property <bool> show-navigation;
    in property <bool> can-previous: true;
    in property <bool> can-next: false;
    callback previous-week();
    callback next-week();
    spacing: 8px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        PanelSectionHeader { title: root.title; vertical-alignment: center; }
        if root.header-percent != "": DigitText { text: root.header-percent; vertical-alignment: center; }
        Rectangle { min-width: 8px; horizontal-stretch: 1; }
        DigitText { text: root.range-label; vertical-alignment: center; }
    }
    if root.show-navigation: WeekChartNavigation {
        can-previous: root.can-previous;
        can-next: root.can-next;
        previous-week => { root.previous-week(); }
        next-week => { root.next-week(); }
    }
    bars := Rectangle {
        height: PanelMetrics.stem-height + 42px;
        private property <int> hovered: touch.has-hover ? HoverMath.column-index(touch.mouse-x, self.width / max(1, root.days.length), root.days.length) : -1;
        HorizontalLayout {
            for day[i] in root.days: DayColumn {
                day: day;
                accent: root.accent;
                hovered: i == bars.hovered;
            }
        }
        private property <length> pointer-x: touch.absolute-position.x + touch.mouse-x;
        private property <length> pointer-y: touch.absolute-position.y + touch.mouse-y;
        touch := TouchArea { }
        // The label is drawn by `HoverOverlayHost` at the window root, above
        // every card; this only publishes what is hovered and where.
        function publish() {
            HoverOverlay.show(
                self.hovered >= 0 && self.hovered < root.days.length,
                root.days[max(0, self.hovered)].hover,
                self.pointer-x, self.pointer-y,
                self.absolute-position.x, self.width, HoverMath.no-limit);
        }
        changed hovered => { self.publish(); }
        changed pointer-x => { self.publish(); }
        changed pointer-y => { self.publish(); }
    }
    if root.footer != "": Text {
        text: root.footer;
        font-family: Typo.family;
        font-size: Typo.body-size;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}

/// Weekly/monthly "Daily Budget" bars with optional week paging. Set
/// `show-navigation` for the paging chevrons; past weeks pass an empty footer.
export component DailyBudgetBars inherits DailyChartBody {
    title: "Daily Budget";
}

/// Grok billing-period daily chart: same visuals, paging always shown.
export component DailyUsageChart inherits DailyChartBody {
    title: "Daily Budget";
    show-navigation: true;
    can-previous: true;
}
